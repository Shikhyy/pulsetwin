{
  "name": "pulsetwin-backend",
  "version": "1.0.0",
  "description": "PulseTwin Backend",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
