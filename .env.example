# =============================================================================
# PulseTwin Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ---- General ----------------------------------------------------------------
NODE_ENV=development
DEMO_SEED=42

# ---- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulsetwin
POSTGRES_USER=pulsetwin
POSTGRES_PASSWORD=changeme_dev_only

# ---- Backend ----------------------------------------------------------------
BACKEND_PORT=3001
JWT_SECRET=changeme_jwt_secret_dev_only
JWT_EXPIRES_IN=8h

# ---- ML Service -------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_ENABLED=true

# ---- Frontend ---------------------------------------------------------------
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# ---- Simulator --------------------------------------------------------------
SIMULATOR_PORT=3002
SIMULATOR_TICK_MS=1000
# How many real seconds = 1 simulated minute (lower = faster demo)
SIMULATOR_TIME_SCALE=1

# ---- Demo -------------------------------------------------------------------
# Automatically start the production simulation on startup (true = live demo instantly)
DEMO_AUTO_START=true
# Accelerate time during demo: 1 real second = 60 simulated seconds
# At 60x: the T+18min bottleneck scenario appears in ~18 real seconds
DEMO_TIME_ACCELERATION=60
